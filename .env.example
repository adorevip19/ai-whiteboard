# Copy to .env; keep real secrets server-side. See ENVIRONMENT_SETUP.md.
# Empty keys are sufficient for JSON -> silent MP4 (--tts false).
GEMINI_API_KEY=
GEMINI_TTS_VOICE=Sulafat
PERPLEXITY_API_KEY=
PERPLEXITY_GENERATE_MODEL=openai/gpt-5.5
PERPLEXITY_REPAIR_MODEL=openai/gpt-5.2
PERPLEXITY_VISION_MODEL=openai/gpt-5.4
PERPLEXITY_MAX_REPAIR_ROUNDS=3
CHROME_EXECUTABLE_PATH=

# Mandatory-interaction classroom (keys stay server-side)
INTERACTIVE_DATA_DIR=
INTERACTIVE_FAMILY_PASSWORD=
INTERACTIVE_PARENT_PIN=
INTERACTIVE_SESSION_SECRET=
INTERACTIVE_AZURE_DAILY_CALLS=100
INTERACTIVE_SEMANTIC_DAILY_CALLS=30

# Explicit opt-in for direct classroom and parent access without passwords.
INTERACTIVE_PASSWORDLESS=false

# Optional persistent data path (directory must be writable)
DATABASE_DIR=

# Optional interactive classroom speech assessment
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
INTERACTIVE_SEMANTIC_MODEL=
